<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Task Manager Automation Test Suite
    - By default, runs tests on Chrome browser only
    - To enable cross-browser testing, set enabled="true" for Firefox and/or Edge tests
    - Adjust thread-count if running multiple browsers in parallel
-->
<suite name="Task Manager Automation Test Suite" parallel="tests" thread-count="1" verbose="1">

    <parameter name="browser" value="chrome"/>

    <!-- Listeners for reporting -->
    <listeners>
        <listener class-name="com.taskmanager.utils.ExtentReportListener"/>
    </listeners>

    <!-- Chrome Browser Tests (Default - Always Enabled) -->
    <test name="Chrome - Task Manager Tests" parallel="false">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.taskmanager.runners.TestRunner"/>
        </classes>
    </test>

    <!-- Firefox Browser Tests (Disabled by default - Set enabled="true" to activate) -->
    <test name="Firefox - Task Manager Tests" parallel="false" enabled="false">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.taskmanager.runners.TestRunner"/>
        </classes>
    </test>

    <!-- Edge Browser Tests (Disabled by default - Set enabled="true" to activate) -->
    <test name="Edge - Task Manager Tests" parallel="false" enabled="false">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.taskmanager.runners.TestRunner"/>
        </classes>
    </test>

</suite>
