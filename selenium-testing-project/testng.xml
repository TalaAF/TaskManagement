<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Task Manager Automation Test Suite" parallel="tests" thread-count="3" verbose="1">

    <parameter name="browser" value="chrome"/>

    <!-- Listeners for reporting -->
    <listeners>
        <listener class-name="com.taskmanager.utils.ExtentReportListener"/>
    </listeners>

    <!-- Chrome Browser Tests -->
    <test name="Chrome - Task Manager Tests" parallel="false">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.taskmanager.runners.TestRunner"/>
        </classes>
    </test>

    <!-- Firefox Browser Tests -->
    <test name="Firefox - Task Manager Tests" parallel="false" enabled="true">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.taskmanager.runners.TestRunner"/>
        </classes>
    </test>

    <!-- Edge Browser Tests -->
    <test name="Edge - Task Manager Tests" parallel="false" enabled="true">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.taskmanager.runners.TestRunner"/>
        </classes>
    </test>

</suite>
